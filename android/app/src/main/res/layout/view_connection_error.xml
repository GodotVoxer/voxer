<?xml version="1.0" encoding="utf-8"?>
<!-- Only for the "outdated WebView" screen, which is inflated without ViewBinding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/errorContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/voxer_surface_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/errorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/voxer_on_surface_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/errorBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/voxer_on_surface_muted_dark"
        android:textSize="15sp" />

    <Button
        android:id="@+id/errorRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/voxer_brand"
        android:textColor="@color/voxer_on_solid" />
</LinearLayout>
