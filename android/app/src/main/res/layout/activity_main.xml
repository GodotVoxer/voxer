<?xml version="1.0" encoding="utf-8"?>
<!--
  The error screen is inline rather than an <include>: with ViewBinding an include with an id exposes
  a nested binding (binding.errorView.errorTitle) instead of direct fields, and the include's id would
  clash with the included root's.

  SwipeRefreshLayout does not scroll by itself: it only shifts its single child during the gesture.
  No ScrollView or NestedScrollView, because `useWindowVirtualizer` measures against the document
  scroll and a parent consuming scroll would misalign `scrollMargin`.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/voxer_surface_dark">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/pullToRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/voxer_surface_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_offline_title"
            android:textColor="@color/voxer_on_surface_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/error_offline_body"
            android:textColor="@color/voxer_on_surface_muted_dark"
            android:textSize="15sp" />

        <Button
            android:id="@+id/errorRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/voxer_brand"
            android:text="@string/error_retry"
            android:textColor="@color/voxer_on_solid" />
    </LinearLayout>
</FrameLayout>
