{
  "name": "voxer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "NEXT_PUBLIC_USE_MOCKS=true next dev",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:backfill-video-posters": "tsx scripts/backfillVideoPosters.ts",
    "db:repair-blank-video-posters": "tsx scripts/repairBlankVideoPosters.ts",
    "db:backfill-registration-ip-hash": "tsx scripts/backfillRegistrationIpHash.ts",
    "db:push": "prisma db push",
    "storage:purge-orphans": "tsx scripts/purgeOrphanUploads.ts",
    "build": "prisma generate && next build && tsx scripts/verifyThemeBuild.ts",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "theme:css": "tsx scripts/generateThemesCss.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-virtual": "^3.13.12",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "argon2": "^0.44.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.2.0",
    "flag-icons": "^7.3.2",
    "fuse.js": "^7.3.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.16",
    "next": "^16.3.8",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.0",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "msw": "^2.10.4",
    "postcss": "^8.5.23",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
