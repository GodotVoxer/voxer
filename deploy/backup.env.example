# Solo lo lee backup.sh. Usá un bucket privado, separado del de la multimedia.
BACKUP_BUCKET=
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Nombre del proveedor S3 en rclone: Cloudflare, AWS, Minio, Other...
BACKUP_S3_PROVIDER=Cloudflare
# BACKUP_RETENTION_DAYS=14
# URL de aviso si el backup deja de correr (por ejemplo healthchecks.io); se llama al terminar bien, y
# con /fail si hay un error.
# HEALTHCHECK_URL=
