# Valores que interpola Docker Compose. La app nunca los ve; su configuración va en app.env.

# Imagen a correr, y el repositorio del que deploy.sh descarga los tags (también espera "<repo>-migrate:<tag>").
VOXER_IMAGE=ghcr.io/vos/voxer:latest
VOXER_IMAGE_REPO=ghcr.io/vos/voxer

# Secretos aleatorios: `openssl rand -hex 32`.
POSTGRES_PASSWORD=
SRH_TOKEN=

# Cabecera con la IP del cliente: cloudflare (por defecto) | xff | none. Tiene que coincidir con lo que
# está delante de Caddy.
# TRUSTED_PROXY=cloudflare

# Con Cloudflare Tunnel, activá el perfil y poné su token. Sin túnel, Caddy escucha en HTTP_BIND para un
# reverse proxy del servidor que termine el TLS.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
# HTTP_BIND=127.0.0.1:8080

# Opcional: purgar la caché de Cloudflare después de cada deploy (token con permiso de Cache Purge).
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_PURGE_TOKEN=
# Hosts a purgar, separados por comas; sin esto se purga toda la zona.
# CLOUDFLARE_PURGE_HOSTS=www.example.com
