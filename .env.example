# Copiá este archivo a `.env` y ajustalo (Prisma solo lee `.env`). Para desarrollar en local solo hacen
# falta DATABASE_URL y AUTH_SECRET; todo lo demás es opcional, y sin eso la función que habilita queda apagada.
# `npm run dev:demo` no necesita nada de esto: corre la interfaz contra datos simulados en el navegador.

# --- Base ---------------------------------------------------------------------------------------

# PostgreSQL. `docker compose up -d` levanta una que coincide con esta URL.
DATABASE_URL=postgresql://voxer:voxer@localhost:5432/voxer
# Conexiones por instancia de la app (5 por defecto).
# PG_POOL_MAX=5

# Firma las cookies de sesión y los tokens de las salas de tiempo real. Al menos 32 caracteres
# aleatorios: `openssl rand -hex 32`.
AUTH_SECRET=

# Pepper del HMAC con el que se guardan las huellas de IP (límites de uso, bans por red); solo se guarda
# el hash. Obligatorio en producción (16 caracteres aleatorios o más); en desarrollo se usa un valor fijo
# inseguro. Cambiarlo invalida los bans por red existentes.
# VOXER_CLIENT_IP_PEPPER=

# Origen público canónico (por ejemplo https://example.com), para las URLs de Open Graph y los scripts.
# NEXT_PUBLIC_APP_URL=

# Qué cabecera del proxy trae la IP del cliente: cloudflare | xff | none (por defecto). Cualquier otra
# cabecera se ignora, porque el cliente la puede falsificar. Tiene que coincidir con el proxy que
# realmente está delante de la app.
# TRUSTED_PROXY=

# --- Almacenamiento de la multimedia --------------------------------------------------------------

# Obligatorio en producción. Sin esto, en desarrollo lo que se sube se guarda en `public/uploads/`, que
# solo sirve `next dev`. Con esto, la multimedia va a un bucket compatible con S3 (Cloudflare R2).
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.example.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Alternativa a R2_S3_ENDPOINT: el id de cuenta de 32 caracteres hex, del que se deduce el endpoint.
# R2_ACCOUNT_ID=
# Los navegadores suben directo al bucket con PUT, así que su política de CORS tiene que permitir PUT
# (y GET/HEAD) desde el origen del sitio.

# Binario de ffmpeg (limpieza de metadatos de video, posters, GIF a MP4). Por defecto, `ffmpeg-static`.
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- Tiempo real --------------------------------------------------------------------------------

# Los clientes se conectan al Worker de Cloudflare de `realtime/` solo con `durable`; cualquier otro
# valor apaga las novedades en vivo. Se incrusta al compilar.
# NEXT_PUBLIC_REALTIME_MODE=durable
# URL del Worker para los navegadores (WebSocket).
# NEXT_PUBLIC_SOCKET_URL=https://realtime.example.com
# El servidor emite eventos solo si está habilitado, a SOCKET_SERVER_URL, autenticado con el secreto
# compartido (32 caracteres o más, el mismo SOCKET_BROADCAST_SECRET que el Worker).
# REALTIME_BROADCAST_ENABLED=true
# SOCKET_SERVER_URL=https://realtime.example.com
# SOCKET_BROADCAST_SECRET=

# --- Límites de uso -----------------------------------------------------------------------------

# API REST de Redis compatible con Upstash. Sin esto, los límites se llevan en memoria por instancia.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Protección del registro --------------------------------------------------------------------

# Cloudflare Turnstile. Sin la clave secreta, el registro no exige el token.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Notificaciones push ------------------------------------------------------------------------

# Interruptor general: sin esto, ningún canal de push hace nada.
# PUSH_ENABLED=true

# App Android (versión `gms`) por Firebase Cloud Messaging (cuenta de servicio del proyecto de Firebase).
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Navegadores de escritorio y app de F-Droid (UnifiedPush), por Web Push estándar. Generá un par con
# `npx web-push generate-vapid-keys`; cambiarlo invalida las suscripciones (los navegadores se vuelven a
# suscribir en su próxima visita con sesión).
# NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# --- App Links de Android -----------------------------------------------------------------------

# Se sirven en /.well-known/assetlinks.json. Separados por comas; las huellas son el SHA-256 de los
# certificados de firma (debug, release, tienda).
# ANDROID_PACKAGE_NAMES=
# ANDROID_APP_FINGERPRINTS=

# --- Operación ----------------------------------------------------------------------------------

# `1` sirve la Content-Security-Policy en modo solo reporte: una salida de emergencia si un cambio la rompe.
# CSP_REPORT_ONLY=1
